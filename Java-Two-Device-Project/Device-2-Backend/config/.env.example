# ==============================================================================
# DISASTER RELIEF SUPPLY & EMERGENCY MEDICAL LOGISTICS DISPATCH SYSTEM (DREMLDS)
# DEVICE 2 (BACKEND & DATABASE) CONFIGURATION TEMPLATE
# ==============================================================================

# Database Connection (MySQL 8 / MariaDB on Device 2)
DB_HOST=localhost
DB_PORT=3307
DB_NAME=disaster_relief_db
DB_USER=host
DB_PASSWORD=1234

# Backend Network Listening Address & Port
# IMPORTANT: SERVER_ADDRESS=0.0.0.0 binds to all network interfaces so Device 1 can connect over Wi-Fi
SERVER_PORT=8080
SERVER_ADDRESS=0.0.0.0

# DDUS Algorithmic Scoring Weights
DDUS_WEIGHT_URGENCY=35.0
DDUS_WEIGHT_POPULATION=35.0
DDUS_WEIGHT_TERRAIN=30.0

# Multithreaded Worker Pool Size
DISPATCH_THREAD_POOL_SIZE=8
