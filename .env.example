# ==============================================================================
# DISASTER RELIEF SUPPLY & EMERGENCY MEDICAL LOGISTICS DISPATCH SYSTEM (DREMLDS)
# ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure for your local Windows 11 or OCI environment
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# Active Spring Profile (e.g., local, oci, test)
SPRING_PROFILES_ACTIVE=local

# Local Windows MySQL 8 Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=disaster_relief_db
DB_USER=relief_app
DB_PASSWORD=ReliefSecurePass2026!

# OCI Production Database Configuration (Used on App Server VM 1)
# DB_HOST=10.0.2.100
# DB_PORT=3306
# DB_NAME=disaster_relief_db
# DB_USER=relief_app
# DB_PASSWORD=ReliefOciSecurePass2026!

# DDUS Algorithm Weights (Must sum to 100 for proper 0-100 normalization)
DDUS_WEIGHT_URGENCY=35.0
DDUS_WEIGHT_POPULATION=35.0
DDUS_WEIGHT_TERRAIN=30.0

# Multithreaded Dispatch Executor Pool Size (Minimum 5 workers)
DISPATCH_THREAD_POOL_SIZE=8

